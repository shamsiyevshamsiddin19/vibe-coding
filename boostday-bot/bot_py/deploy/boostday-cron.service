[Unit]
Description=Boostday cron (rejalashtirilgan yuborishlar)
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/opt/boostday-bot/bot_py
EnvironmentFile=/opt/boostday-bot/bot_py/.env
ExecStart=/opt/boostday-bot/bot_py/.venv/bin/python /opt/boostday-bot/bot_py/run_cron.py
