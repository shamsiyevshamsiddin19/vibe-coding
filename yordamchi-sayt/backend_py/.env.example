# === Yordamchi backend konfiguratsiyasi ===
# Bu faylni `.env` deb nusxalang va qiymatlarni to'ldiring. .env ni HECH QACHON git'ga qo'ymang.

# --- Baza (PostgreSQL) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=yordamchi
DB_USER=yordamchi
DB_PASS=CHANGE_ME

# --- Sessiya / xavfsizlik ---
# Majburiy! Yarating:  openssl rand -hex 32
SESSION_SECRET=
SESSION_HTTPS_ONLY=true
# true bo'lsa — saytga kirish uchun ro'yxatdan o'tish/login talab qilinadi.
# Internetga ochiq serverda DOIM true qoldiring: aks holda manzilni bilgan
# har kim ma'lumotlaringizni o'qiy va o'zgartira oladi.
# Ro'yxatdan o'tish faqat BIRINCHI akkaunt uchun ochiq (keyin yopiladi).
REQUIRE_AUTH=true

# --- Rejim ---
APP_DEBUG=false

# --- Statik frontend ---
# nginx statikani tarqatsa: false. FastAPI o'zi tarqatsa: true.
SERVE_STATIC=false
# PHP loyihaning ildizi (index.html, assets/, uploads/ shu yerda). Default: backend_py ning ota-papkasi.
# FRONTEND_ROOT=/var/www/yordamchi

# --- CORS (bir domen bo'lsa bo'sh qoldiring) ---
CORS_ORIGINS=

# --- Login rate-limit ---
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

# --- Boostday bot integratsiyasi (ixtiyoriy) ---
# Saytdagi "Boost" bo'limi bot API'siga proxy qiladi. Botni ishlatmasangiz
# bu qatorlarni bo'sh qoldiring — bo'lim shunchaki ishlamaydi, xato bermaydi.
BOOST_API_URL=http://127.0.0.1:8090/boost/api
# Bot tomonidagi SITE_SECRET bilan BIR XIL bo'lishi SHART:
#   openssl rand -hex 32
BOOST_SITE_SECRET=
